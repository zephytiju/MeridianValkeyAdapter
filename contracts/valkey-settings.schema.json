{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zephytiju/meridian-storage-valkey/contracts/valkey-settings.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Meridian Valkey V1 Binding settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaceGeneration", "resources"],
  "properties": {
    "namespaceGeneration": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaFingerprint"],
        "properties": {
          "schemaFingerprint": {"$ref": "#/$defs/fingerprint"},
          "serializerId": {"enum": ["canonical-json", "raw-bytes"]},
          "defaultTtlMs": {"$ref": "#/$defs/positiveMs"},
          "maximumStalenessMs": {"$ref": "#/$defs/positiveMs"},
          "negativeCaching": {"type": "boolean"},
          "authoritative": {"const": false}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxKeyBytes": {"type": "integer", "minimum": 96, "maximum": 4096},
        "maxValueBytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "maxBatchSize": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "ttl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTtlMs": {"$ref": "#/$defs/positiveMs"},
        "minimumTtlMs": {"$ref": "#/$defs/positiveMs"},
        "maximumTtlMs": {"$ref": "#/$defs/positiveMs"},
        "negativeTtlMs": {"$ref": "#/$defs/positiveMs"}
      }
    },
    "singleFlight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseMs": {"type": "integer", "minimum": 10, "maximum": 600000},
        "waitMs": {"type": "integer", "minimum": 0, "maximum": 600000},
        "pollMs": {"type": "integer", "minimum": 1, "maximum": 60000}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireMaxmemory": {"type": "boolean"},
        "allowedEvictionPolicies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "requirePersistenceDisabled": {"type": "boolean"}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["standalone", "sentinel"]},
        "minimumReplicas": {"type": "integer", "minimum": 0, "maximum": 100},
        "sentinelMaster": {"type": ["string", "null"]}
      }
    },
    "database": {"type": "integer", "minimum": 0, "maximum": 15},
    "seedEndpoints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "allowInsecureTestProfile": {"type": "boolean"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positiveMs": {"type": "integer", "minimum": 1, "maximum": 2147483647}
  }
}
