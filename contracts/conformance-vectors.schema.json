{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zephytiju/meridian-storage-valkey/contracts/conformance-vectors.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Meridian Valkey V1 conformance vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "keyEncoding", "envelopes", "scripts", "descriptor"],
  "properties": {
    "$comment": {"type": "string"},
    "formatVersion": {"const": "meridian-valkey-conformance.v1"},
    "keyEncoding": {"type": "object"},
    "envelopes": {"type": "object"},
    "scripts": {"type": "object"},
    "descriptor": {"type": "object"}
  }
}
